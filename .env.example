# Server
PORT=4319
HOST=127.0.0.1

# SQLite file. Defaults to ./data/retention.db (git-ignored).
# DB_PATH=/var/lib/retention/retention.db

# Seed demo tenants on first start when the database is empty.
SEED_ON_START=1

# Master secret used to derive per-tenant proof keys.
# PRODUCTION: supply this from your secret manager; do not commit it, and do not
# co-locate it with the database. Proofs are only meaningful while this secret
# remains under your control.
MASTER_SECRET=change-me-in-production
